<Project>
  <Import Project="$(MSBuildThisFileDirectory)Metadata.props"/>

  <Target Name="Metadata">
    <ItemGroup>
      <GitHubEnvLine Include="ReleaseTagName=$(CustomUnifiedVersion)" />
      <GitHubEnvLine Include="ReleaseName=Application Release $(CustomUnifiedVersion) ($(CustomInformationalVersionSuffix))" />
      <GitHubEnvLine Include="AppProductName=$(Product)" />
    </ItemGroup>   
    <WriteLinesToFile File="$(MSBuildThisFileDirectory)test.txt" Lines="@(GitHubEnvLine)" Overwrite="false" Encoding="Utf-8" />
  </Target>
</Project>
